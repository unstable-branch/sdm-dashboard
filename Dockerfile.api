FROM docker.io/library/node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS builder

LABEL org.opencontainers.image.title="SDM Dashboard — API"
LABEL org.opencontainers.image.description="Hono BFF API server with BullMQ job queue"
LABEL org.opencontainers.image.source="https://github.com/unstable-branch/sdm-dashboard"

RUN apk add --no-cache dumb-init curl bash build-base

RUN npm install -g pnpm@10.30.3

WORKDIR /app

COPY scripts/auto-registry.sh /usr/local/bin/auto-registry.sh
RUN chmod +x /usr/local/bin/auto-registry.sh

ARG PNPM_REGISTRY=
ENV PNPM_REGISTRY=${PNPM_REGISTRY:-https://registry.npmmirror.com}
ENV PNPM_FETCH_TIMEOUT=300000
ENV PNPM_FETCH_RETRIES=5

RUN if [ -z "${PNPM_REGISTRY##*auto*}" ]; then \
        export PNPM_REGISTRY=$(auto-registry.sh); \
    fi

COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml* ./
COPY packages/shared/package.json packages/shared/
COPY api/package.json api/
COPY frontend/package.json frontend/

RUN pnpm install --frozen-lockfile

COPY packages/shared/ packages/shared/
COPY api/ api/
COPY frontend/ frontend/
RUN cc -std=c11 -O2 -Wall -Wextra -Werror api/publish-example.c -o /app/publish-example

# If pre-built shared dist exists (from CI artifact), skip rebuild
RUN if [ ! -f packages/shared/dist/index.js ]; then pnpm --filter @sdm/shared build; fi
RUN pnpm --filter @sdm/api build

# Create production deployment with only production dependencies
RUN pnpm --filter @sdm/api deploy --prod --legacy /app/deploy

FROM docker.io/library/node:22-alpine@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS runner

LABEL org.opencontainers.image.title="SDM Dashboard — API"
LABEL org.opencontainers.image.description="Hono BFF API server with BullMQ job queue"
LABEL org.opencontainers.image.source="https://github.com/unstable-branch/sdm-dashboard"

RUN apk add --no-cache dumb-init curl su-exec

WORKDIR /app

# pnpm legacy deploy emits a self-contained, flat package directory.
COPY --from=builder /app/deploy ./api
COPY data/examples/ /app/data/examples/
COPY data/examples/ /usr/share/sdm/examples-seed/

RUN addgroup -g 2000 sdm-shared && \
    addgroup node sdm-shared && \
    mkdir -p /app/data/uploads /app/data/examples /app/outputs && \
    chgrp -R sdm-shared /app/data/uploads /app/data/examples /app/outputs && \
    chmod 2775 /app/data/uploads /app/data/examples /app/outputs && \
    chmod -R g+rwX /app/data/examples && \
    find /app/data/examples -type d -exec chmod g+s {} + && \
    chmod -R a-w /usr/share/sdm/examples-seed

COPY api/docker-entrypoint.sh /usr/local/bin/api-entrypoint.sh
COPY api/prepare-examples.cjs /usr/local/lib/sdm/prepare-examples.cjs
COPY --from=builder /app/publish-example /usr/local/lib/sdm/publish-example
RUN chmod 0755 /usr/local/bin/api-entrypoint.sh

ENV NODE_OPTIONS="--max-old-space-size=2048"

# Container-level liveness probe. Matches the compose-level healthcheck at
# docker-compose*.yml and ensures Kubernetes / standalone runtimes can detect
# a hung API process.
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
    CMD curl -fsS http://localhost:4000/health || exit 1

# Note: USER is intentionally NOT set here. The api-entrypoint.sh uses
# su-exec to briefly run as root to chgrp/chmod shared volumes, then exec
# the CMD as the unprivileged `node` user. CONTRACT: any future change to
# ENTRYPOINT / CMD must preserve the su-exec wrapper. See
# scripts/test-accelerator-contracts.sh for the enforcement.

ENTRYPOINT ["dumb-init", "--", "/usr/local/bin/api-entrypoint.sh"]
CMD ["sh", "-c", "npm --prefix api run db:migrate && node api/dist/index.js"]
