# Image digests are copied from image-digests.txt in the reviewed draft release.
# Keep dedicated variant digests together; sdm-setup writes one canonical active pair.
SDM_RELEASE_VERSION=2.0.0-beta.5
SDM_FRONTEND_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
SDM_API_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
SDM_PLUMBER_CPU_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
SDM_PLUMBER_CUDA_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
SDM_PLUMBER_ROCM_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
SDM_PLUMBER_VARIANT=cpu
SDM_PLUMBER_DIGEST=sha256:REPLACE_WITH_RELEASE_DIGEST
